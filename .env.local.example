# Supabase 프로젝트 설정 (supabase.com → 프로젝트 → Project Settings → API)
# 이 파일을 복사해서 .env.local 로 저장하고 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore 에 포함되어 있어 커밋되지 않습니다.

# 프로젝트 URL과 anon(공개) 키 — 브라우저에도 노출되는 값입니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# service_role 키 — 절대 브라우저로 보내지 마세요. 서버 코드에서만 사용합니다.
# (2단계 고객 페이지에서 토큰 기반 조회에 사용 예정)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
